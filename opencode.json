{
  "mcp": {
    "servers": {
      "shadcn": {
        "type": "local",
        "command": ["npx", "shadcn@4.23.0", "mcp"],
        "cwd": "web"
      },
      "railway": {
        "type": "remote",
        "url": "https://mcp.railway.com"
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "$schema": "https://opencode.ai/config.json"
}
